# Copy to deploy/.env.prod (chmod 600). Every secret comes from your secret manager; never commit it.
# Generate random values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and the data key with:       python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

MEDSEAL_DOMAIN=medseal.example.uz
MEDSEAL_PG_PASSWORD=

# AES-256-GCM key for data at rest (key files, TOTP secrets, sealed images, inbox results).
# Back it up OFFLINE, separately from the data: losing it = losing the encrypted data.
MEDSEAL_DATA_KEY=
# HMAC salt binding a DICOM PatientID into the seal without storing it. Never change it once in use.
MEDSEAL_PATIENT_SALT=

# Signing keys: an HSM over PKCS#11 (preferred) ...
MEDSEAL_KEY_BACKEND=pkcs11
MEDSEAL_PKCS11_LIB=/usr/lib/your-hsm/libpkcs11.so
MEDSEAL_PKCS11_TOKEN=medseal
MEDSEAL_PKCS11_PIN=
# ... or encrypted key files, as a documented, deliberate risk decision:
# MEDSEAL_KEY_BACKEND=file
# MEDSEAL_ALLOW_SOFTWARE_KEYS=1

# Blockchain anchoring (docs/BLOCKCHAIN.md): a real network, never a local dev chain.
RPC_URL=
CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=
CHAIN_ID=
EXPLORER_URL=

# Patient image previews in the doctor's inbox are removed after this many days (verdicts stay).
MEDSEAL_INBOX_PREVIEW_DAYS=90

# Web sealing acts as this site's gateway device (mint with POST /backend/devices as an admin).
MEDSEAL_DEVICE_TOKEN=

# Never set in production: MEDSEAL_ADMIN_TOKEN, MEDSEAL_DOCTOR_TOKEN (the backend refuses to start).
