# Copy to .env.local. Server-only values have no NEXT_PUBLIC_ prefix and never reach the browser.
# Backend runs separately: uvicorn app.main:app --port 8000 (or the production compose stack).

# Demo data is opt-in for development only: NEXT_PUBLIC_USE_MOCK=1. Never in a production build.
NEXT_PUBLIC_USE_MOCK=0
# Public endpoints the browser calls directly (verify, QR check, statistics).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-side backend URL used by the route handlers (src/app/api/**).
MEDSEAL_BACKEND_URL=http://localhost:8000/api

# People sign in with their personal accounts (/login); the session is an httpOnly cookie and the
# backend decides every role. There are no shared logins or role tokens here any more.
# The first admin is created on the backend: python -m scripts.create_user --role admin ...

# Web sealing acts as this hospital's gateway device, for signed-in operators/admins only.
# Mint the token on the backend (POST /api/devices as an admin, or scripts.create_demo_device).
MEDSEAL_DEVICE_TOKEN=

# Only for a plain-http lab setup: 0 drops the Secure flag of the session cookie. Never in production.
# MEDSEAL_COOKIE_SECURE=0
